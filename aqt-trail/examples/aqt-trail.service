# systemd user unit for the aqt-trail writer in user mode (not installed automatically).
# Install: copy to ~/.config/systemd/user/aqt-trail.service, adjust ExecStart, then
#   systemctl --user daemon-reload && systemctl --user enable --now aqt-trail
# If you set XDG_STATE_HOME or XDG_CONFIG_HOME in your shell, add the same values here
# (Environment=XDG_STATE_HOME=...), or the service uses a different trail.
# Separate-user mode uses aqt-trail-system.service instead (docs/separate-user.md).
[Unit]
Description=aqt-trail audit-trail writer (user mode)

[Service]
Type=simple
# Path to the aqt-trail console script of your installation:
ExecStart=%h/agent-quality-toolkit/.venv/bin/aqt-trail serve
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
