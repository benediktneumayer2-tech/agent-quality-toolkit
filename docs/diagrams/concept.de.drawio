        <mxCell id="v-56" value="Laufen automatisch. aqt-quarantine&#10;prüft Web-, Such- und MCP-&#10;Ergebnisse, bevor das Modell sie&#10;sieht. aqt-change blockiert&#10;„fertig“ ohne frische bestandene&#10;Belege. aqt-trail protokolliert." style="text=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Arial,Helvetica,sans-serif;fontSize=14;fontColor=#172033;fontStyle=0;spacing=0;" vertex="1" parent="v-54">
          <mxGeometry x="14" y="38" width="240" height="112" as="geometry" />
        </mxCell>
        <mxCell id="v-57" value="Befehle · jeder Agent" style="rounded=1;absoluteArcSize=1;arcSize=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;fontFamily=Arial,Helvetica,sans-serif;fontSize=15;fontStyle=1;fontColor=#172033;align=left;verticalAlign=top;spacingLeft=44;spacingTop=12;" vertex="1" parent="panel">
          <mxGeometry x="304" y="640" width="262" height="158" as="geometry" />
        </mxCell>
        <mxCell id="v-58" value="2" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=#334155;strokeColor=#334155;fontFamily=Arial,Helvetica,sans-serif;fontSize=13;fontStyle=1;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="v-57">
          <mxGeometry x="12" y="9" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="v-59" value="Jeder Agent mit Shell nutzt&#10;dieselben Werkzeuge, etwa&#10;aqt-change run (das Werkzeug&#10;führt die Tests aus) und&#10;aqt-signoff prepare (eine Aktion&#10;wartet auf Genehmigung)." style="text=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Arial,Helvetica,sans-serif;fontSize=14;fontColor=#172033;fontStyle=0;spacing=0;" vertex="1" parent="v-57">
          <mxGeometry x="14" y="38" width="240" height="112" as="geometry" />
        </mxCell>
        <mxCell id="v-60" value="Terminal-Relais" style="rounded=1;absoluteArcSize=1;arcSize=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;fontFamily=Arial,Helvetica,sans-serif;fontSize=15;fontStyle=1;fontColor=#172033;align=left;verticalAlign=top;spacingLeft=44;spacingTop=12;" vertex="1" parent="panel">
          <mxGeometry x="580" y="640" width="262" height="158" as="geometry" />
        </mxCell>
        <mxCell id="v-61" value="3" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=#334155;strokeColor=#334155;fontFamily=Arial,Helvetica,sans-serif;fontSize=13;fontStyle=1;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="v-60">
          <mxGeometry x="12" y="9" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="v-62" value="aqt-sensei leitet Rat zwischen&#10;zwei Agenten-Terminals weiter&#10;(tmux oder Herdr). Im Standard-&#10;modus gibt ein Mensch jede&#10;Nachricht frei." style="text=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Arial,Helvetica,sans-serif;fontSize=14;fontColor=#172033;fontStyle=0;spacing=0;" vertex="1" parent="v-60">
          <mxGeometry x="14" y="38" width="240" height="112" as="geometry" />
        </mxCell>
        <mxCell id="v-63" value="Beobachtung und Import" style="rounded=1;absoluteArcSize=1;arcSize=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;fontFamily=Arial,Helvetica,sans-serif;fontSize=15;fontStyle=1;fontColor=#172033;align=left;verticalAlign=top;spacingLeft=44;spacingTop=12;" vertex="1" parent="panel">
          <mxGeometry x="856" y="640" width="262" height="158" as="geometry" />
        </mxCell>
        <mxCell id="v-64" value="4" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=#334155;strokeColor=#334155;fontFamily=Arial,Helvetica,sans-serif;fontSize=13;fontStyle=1;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="v-63">
          <mxGeometry x="12" y="9" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="v-65" value="Das Schreibprogramm des Audit&#10;Trails fragt den Linux-Kernel,&#10;welches Programm jeden Eintrag&#10;sandte. aqt-trail importiert&#10;Sitzungsprotokolle von Claude&#10;Code, Codex und pi." style="text=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Arial,Helvetica,sans-serif;fontSize=14;fontColor=#172033;fontStyle=0;spacing=0;" vertex="1" parent="v-63">
          <mxGeometry x="14" y="38" width="240" height="112" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>