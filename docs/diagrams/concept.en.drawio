          <mxGeometry x="12" y="9" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="v-59" value="Any agent with a shell runs the&#10;same tools, for example&#10;aqt-change run (the tool runs&#10;the tests) and aqt-signoff&#10;prepare (an action that waits&#10;for approval)." style="text=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Arial,Helvetica,sans-serif;fontSize=14;fontColor=#172033;fontStyle=0;spacing=0;" vertex="1" parent="v-57">
          <mxGeometry x="14" y="38" width="240" height="112" as="geometry" />
        </mxCell>
        <mxCell id="v-60" value="Terminal relay" style="rounded=1;absoluteArcSize=1;arcSize=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;fontFamily=Arial,Helvetica,sans-serif;fontSize=15;fontStyle=1;fontColor=#172033;align=left;verticalAlign=top;spacingLeft=44;spacingTop=12;" vertex="1" parent="panel">
          <mxGeometry x="580" y="640" width="262" height="158" as="geometry" />
        </mxCell>
        <mxCell id="v-61" value="3" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=#334155;strokeColor=#334155;fontFamily=Arial,Helvetica,sans-serif;fontSize=13;fontStyle=1;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="v-60">
          <mxGeometry x="12" y="9" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="v-62" value="aqt-sensei passes advice between&#10;two agent terminals (tmux or&#10;Herdr). In the default mode the&#10;owner approves each message." style="text=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Arial,Helvetica,sans-serif;fontSize=14;fontColor=#172033;fontStyle=0;spacing=0;" vertex="1" parent="v-60">
          <mxGeometry x="14" y="38" width="240" height="112" as="geometry" />
        </mxCell>
        <mxCell id="v-63" value="Observation and import" style="rounded=1;absoluteArcSize=1;arcSize=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;fontFamily=Arial,Helvetica,sans-serif;fontSize=15;fontStyle=1;fontColor=#172033;align=left;verticalAlign=top;spacingLeft=44;spacingTop=12;" vertex="1" parent="panel">
