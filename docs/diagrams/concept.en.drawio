        <mxCell id="v-64" value="4" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=#334155;strokeColor=#334155;fontFamily=Arial,Helvetica,sans-serif;fontSize=13;fontStyle=1;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="v-63">
          <mxGeometry x="12" y="9" width="24" height="24" as="geometry" />
        </mxCell>
        <mxCell id="v-65" value="The trail writer asks the Linux&#10;kernel which program sent each&#10;record. aqt-trail imports Claude&#10;Code, Codex and pi session logs." style="text=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Arial,Helvetica,sans-serif;fontSize=14;fontColor=#172033;fontStyle=0;spacing=0;" vertex="1" parent="v-63">
