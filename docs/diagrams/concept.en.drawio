        <mxCell id="v-57" value="Commands · any agent" style="rounded=1;absoluteArcSize=1;arcSize=10;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;fontFamily=Arial,Helvetica,sans-serif;fontSize=15;fontStyle=1;fontColor=#172033;align=left;verticalAlign=top;spacingLeft=44;spacingTop=12;" vertex="1" parent="panel">
