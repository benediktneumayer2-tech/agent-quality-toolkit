{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Quality Toolkit",
  "mainBinaryName": "aqt-desktop",
  "version": "0.2.0",
  "identifier": "io.github.benediktneumayer2tech.aqt",
  "build": {
    "frontendDist": "../frontend",
    "beforeBuildCommand": "node scripts/sync-frontend.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "DeveloperTool",
    "shortDescription": "Quality management controls for AI coding agents",
    "longDescription": "Agent Quality Toolkit: the quality desk for AI coding agents (held pages, changes, signatures, audit trail) as a desktop app, with the aqt command inside.",
    "license": "Apache-2.0",
    "homepage": "https://github.com/benediktneumayer2-tech/agent-quality-toolkit",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "linux": { "deb": { "desktopTemplate": "aqt-desktop.desktop" } }
  },
  "plugins": {
    "deep-link": { "desktop": { "schemes": ["aqt"] } },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ2MTI5NzYwOUE2MTFDQzQKUldURUhHR2FZSmNTMXROWjdtd2N6akU0THM4Qm95NnRNcU13dEtxWGszYndhNzFtbnBwMmNxcUgK",
      "endpoints": ["https://github.com/benediktneumayer2-tech/agent-quality-toolkit/releases/latest/download/latest.json"],
      "requireSignedVersion": true
    }
  }
}
