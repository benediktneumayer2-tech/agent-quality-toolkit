{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aqt:schema:0.1:checkpoint",
  "title": "Signed checkpoint (chain head statement)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "aqt_checkpoint",
    "log",
    "seq",
    "head",
    "time",
    "sig"
  ],
  "properties": {
    "aqt_checkpoint": {
      "const": "0.1"
    },
    "log": {
      "type": "string",
      "minLength": 1
    },
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "head": {
      "$ref": "urn:aqt:schema:0.1:common#/$defs/sha256"
    },
    "time": {
      "$ref": "urn:aqt:schema:0.1:common#/$defs/time"
    },
    "sig": {
      "$ref": "urn:aqt:schema:0.1:common#/$defs/ed25519_sig"
    }
  }
}
