{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aqt:schema:0.1:data:trail.gap",
  "title": "trail.gap data",
  "description": "Spooled records follow; marks the time the writer was unavailable",
  "type": "object",
  "properties": {
    "reason": {
      "type": "string"
    },
    "first_time": {
      "$ref": "urn:aqt:schema:0.1:common#/$defs/time"
    },
    "last_time": {
      "$ref": "urn:aqt:schema:0.1:common#/$defs/time"
    },
    "count": {
      "type": "integer"
    },
    "spool_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
